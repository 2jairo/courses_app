RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2f
WHISPERCPP_MODEL_PATH=./ggml-medium.bin
SEGMENT_DURATION=6
PROCESSED_FILES_BASE_PATH=/app/noraw
RAW_FILES_BASE_PATH=/app/raw
USE_GPU=false
NVENC_ENCODE_SESSIONS_LIMIT=8 #https://developer.nvidia.com/video-encode-and-decode-gpu-support-matrix-new
CPU_ENCODE_SESSIONS_LIMIT=4
RABBITMQ_CONSUMER_TIMEOUT_MS=7200000 # 2h
